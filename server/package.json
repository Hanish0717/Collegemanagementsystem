{
  "name": "college-management-backend",
  "version": "1.0.0",
  "description": "Backend for College Management System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:e2e": "vitest run --threads=false",
    "seed": "node src/seeders/seed.js",
    "seed:rbac": "node src/seeders/seedRBAC.js",
    "seed:students": "node src/seeders/seedStudents.js",
    "seed:faculty": "node src/seeders/seedFaculty.js",
    "seed:parents": "node src/seeders/seedParents.js",
    "seed:library": "node src/seeders/seedLibrary.js",
    "seed:hostel": "node src/seeders/seedHostel.js",
    "seed:transport": "node src/seeders/seedTransport.js",
    "seed:placement": "node src/seeders/seedPlacement.js",
    "seed:cms": "node src/seeders/seedCMS.js",
    "seed:ai": "node src/seeders/seedAI.js",
    "seed:audit": "node src/seeders/seedAudit.js",
    "seed:exams": "node src/seeders/seedExams.js",
    "inspect": "node ../inspect_db_local.js"
  },
  "keywords": [
    "college",
    "management",
    "erp",
    "education"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.43.4",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^3.4.0",
    "express": "^4.18.2",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.8",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "nodemonConfig": {
    "ignore": [
      "src/config/mock_db.json",
      "*.log",
      "*.txt",
      "node_modules"
    ]
  }
