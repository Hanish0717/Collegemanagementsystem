# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration (Supabase PostgreSQL Connection String)
# Format: postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres
DATABASE_URL=your_supabase_postgresql_connection_string_here

# Supabase API Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# Frontend application URL
FRONTEND_URL=http://localhost:5173

# Email SMTP configuration (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=hanishvavilapalli@gmail.com
EMAIL_PASS=syvrenpxptlzssuz
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false


# API Keys
FAST2SMS_API_KEY=your_fast2sms_api_key
TEXTBELT_API_KEY=your_textbelt_api_key

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here


